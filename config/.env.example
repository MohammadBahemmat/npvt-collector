# ---- بات تلگرام (فقط برای ارسال پیام به کانال مقصدِ خودتان) ----
# از @BotFather بسازید؛ نیاز به شماره تلفن شخصی یا لاگین اکانت کاربری نیست.
BOT_TOKEN=123456:your_bot_token_here

# ---- کانال مقصد؛ بات باید در آن دسترسی ارسال پیام (ادمین) داشته باشد ----
TARGET_CHANNEL=@your_target_channel_or_-100xxxxxxxxxx

# ---- تنظیمات اختیاری (برای احتیاط در برابر محدودیت نرخ درخواست) ----
SLEEP_BETWEEN_CHANNELS=1.5
SLEEP_BETWEEN_PAGES=1
MAX_PAGES_PER_CHANNEL=3
REQUEST_TIMEOUT=10

# ---- کنترل نرخ ارسال پیام به تلگرام (فقط ۲ پیام در هر اجرا: هدر + فهرست) ----
SLEEP_BETWEEN_SENDS=2
MAX_SEND_RETRIES=6
MAX_RETRY_AFTER_WAIT=90

# ---- سقف تعداد فایل در هر اجرا؛ اگر بیشتر پیدا شود، فقط جدیدترین‌ها (بر ----
# ---- اساس زمان انتشار) ارسال و بقیه کاملاً کنار گذاشته می‌شوند (نه صف) ----
MAX_FILES_PER_MESSAGE=10
