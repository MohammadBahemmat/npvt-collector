# ---- بات تلگرام (فقط برای ارسال پیام به کانال مقصدِ خودتان) ----
# از @BotFather بسازید؛ نیاز به شماره تلفن شخصی یا لاگین اکانت کاربری نیست.
BOT_TOKEN=123456:your_bot_token_here

# ---- کانال مقصد؛ بات باید در آن دسترسی ارسال پیام (ادمین) داشته باشد ----
TARGET_CHANNEL=@your_target_channel_or_-100xxxxxxxxxx

# ---- تنظیمات اختیاری (برای احتیاط در برابر محدودیت نرخ درخواست) ----
SLEEP_BETWEEN_CHANNELS=1.5
SLEEP_BETWEEN_PAGES=1
MAX_PAGES_PER_CHANNEL=3
REQUEST_TIMEOUT=10

# ---- تعداد کانالی که هر اجرا پردازش می‌کند (برای جلوگیری از طولانی شدن ----
# ---- بیش‌ازحد اجرا وقتی تعداد کانال‌ها زیاد است؛ ۰ = همه در یک اجرا)     ----
CHANNELS_PER_RUN=15

# ---- کنترل نرخ ارسال پیام به تلگرام (برای جلوگیری از خطای 429) ----
# تلگرام برای پیام‌های یک بات به یک چت، تقریباً حداکثر ۲۰ پیام در دقیقه را
# مجاز می‌داند؛ مقدار پیش‌فرض زیر با کمی حاشیه‌ی امن تنظیم شده.
SLEEP_BETWEEN_SENDS=3.5
MAX_SEND_RETRIES=6
MAX_RETRY_AFTER_WAIT=90

# ---- سقف تعداد پیام ارسالی در هر اجرا؛ باقی در data/pending_send.json ----
# ---- برای اجرای بعدی می‌مانند (هیچ فایلی گم نمی‌شود، فقط دیرتر می‌رسد) ----
MAX_SENDS_PER_RUN=40
